	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Precisamos acessar a camera para capturar sua foto e os documentos do onboarding.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Precisamos acessar sua galeria para selecionar fotos e documentos do onboarding.</string>
